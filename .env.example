# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<gemini-key>
OPENAI_API_KEY=<openai-key>
ANTHROPIC_API_KEY=<anthropic-key>

# ── 결제 (실결제 전 live_ 키로 교체 필수) ─────────────────────────────────────
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# ── 카카오 알림톡 ─────────────────────────────────────────────────────────────
KAKAO_APP_KEY=<app-key>
KAKAO_SENDER_KEY=<sender-key>
KAKAO_REST_API_KEY=<rest-api-key>

# ── 네이버 검색광고 API ───────────────────────────────────────────────────────
NAVER_CLIENT_ID=<client-id>
NAVER_CLIENT_SECRET=<client-secret>
NAVER_SEARCHAD=<searchad-key>

# ── 앱 설정 ───────────────────────────────────────────────────────────────────
BACKEND_URL=https://aeolab.co.kr
SECRET_KEY=<random-secret>
APP_ENV=development  # development | production

# ── 점수 모델 (베타 5명+ 후 v3_1 활성화) ─────────────────────────────────────
SCORE_MODEL_VERSION=v3_0  # v3_0 | v3_1 | v3_2

# ── 네이버 AI탭 상태 (6월 전체 확대 후 available 로 변경) ─────────────────────
AI_TAB_STATUS=beta  # beta | available — 6월 전체 확대 후 available로 변경

# ── Playwright 동시성 (RAM 4GB 기준 1 고정, 업그레이드 후 2~3 검토) ────────────
BACKEND_MAX_CONCURRENCY=2

# ── 키워드 제안 모델 ──────────────────────────────────────────────────────────
KEYWORD_SUGGEST_MODEL=claude-haiku-4-5-20251001
